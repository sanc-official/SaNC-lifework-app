{
  "name": "sanc-lifework-api",
  "version": "0.1.0",
  "private": true,
  "description": "SaNC Lifework Log の同期API（Cloudflare Workers + D1）",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute sanc-lifework --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute sanc-lifework --local --file=schema.sql"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
